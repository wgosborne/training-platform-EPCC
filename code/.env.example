# Database Configuration
# SQL Server connection string for local development
# Format: sqlserver://[user:password@][host][:port]/[database]?[params]
# Example: sqlserver://sa:YourPassword123@localhost:1433/running_trainer?encrypt=true&trustServerCertificate=true
DATABASE_URL=sqlserver://sa:YOUR_PASSWORD@localhost:1433/running_trainer?encrypt=true&trustServerCertificate=true

# Application Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info
